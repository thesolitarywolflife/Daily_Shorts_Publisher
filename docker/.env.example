# Copy to .env in this folder: cp .env.example .env
# n8n UI login (change these)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password

# Gemini — required for "Gemini title + captions" Code node (cannot use n8n credential UI)
# Create key: https://aistudio.google.com/apikey (AIza… or AQ.…)
# New keys: use Workflow gemini_model gemini-3.5-flash-lite (2.5 may be blocked)
GEMINI_API_KEY=

# Meta (when Instagram / Facebook Reels are wired)
META_IG_USER_ID=
META_FB_PAGE_ID=

# n8n binary storage: default = in-memory (recommended for this workflow)
N8N_DEFAULT_BINARY_DATA_MODE=default

# Optional: encryption key for credentials (generate: openssl rand -hex 32)
# N8N_ENCRYPTION_KEY=
